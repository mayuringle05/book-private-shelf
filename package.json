{
  "name": "book-private-shelf",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": ">=20.12.0"},
  "scripts": {
    "dev": "npm run vengeance:sync && next dev",
    "build": "npm run vengeance:sync && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "vengeance:sync": "node scripts/sync-vengeance.mjs",
    "db:ensure": "node scripts/ensure-database.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:setup": "npm run db:ensure && npm run db:migrate && npm run db:seed",
    "verify": "npm run contract-check && npm run typecheck && npm run lint",
    "contract-check": "node scripts/contract-check.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "2.1.1",
    "framer-motion": "13.2.0",
    "gsap": "^3.13.0",
    "lucide-react": "1.45.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.5.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "3.6.0",
    "three": "0.186.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.185.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0"
  }
}
